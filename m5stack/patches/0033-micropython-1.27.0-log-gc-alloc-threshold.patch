+int mp_hal_gc_log_ready(void) {
+    #if MICROPY_HW_USB_CDC && !defined(NO_QSTR)
+    return tusb_inited();
+    #else
+    return 0;
+    #endif
+}
+
+void mp_hal_gc_log_write(const char *str, size_t len) {
+    // Direct TinyUSB CDC FIFO write. mp_hal_stdout_tx_strn() is not safe here:
+    // it calls dupterm (Python) and mp_usbd_cdc_tx_strn() can block in
+    // mp_event_wait_ms(), which runs the scheduler. gc_alloc() is on the
+    // MicroPython task with the GIL held, the same context as a normal print,
+    // but it must not re-enter the allocator.
+    #if MICROPY_HW_USB_CDC && !defined(NO_QSTR)
+    if (!tusb_inited() || str == NULL || len == 0) {
+        return;
+    }
+    uint32_t avail = tud_cdc_write_available();
+    if (avail < len) {
+        // One non-blocking flush in case a short packet is sitting in the FIFO.
+        // Do not wait for the host; drop the line if it still does not fit.
+        tud_cdc_write_flush();
+        avail = tud_cdc_write_available();
+        if (avail < len) {
+            return;
+        }
+    }
+    uint32_t wrote = tud_cdc_write(str, (uint32_t)len);
+    if (wrote > 0) {
+        tud_cdc_write_flush();
+    }
+    #else
+    (void)str;
+    (void)len;
+    #endif
+}
+
