+    #if defined(ESP_PLATFORM)
+    else if (!collected) {
+        gc_threshold_log(0, MP_STATE_MEM(gc_alloc_amount), MP_STATE_MEM(gc_alloc_threshold), 0, 0);
+    }
+    #endif
     #endif
 
