+static void gc_incremental_start_sweep(void) {
+    #if MICROPY_GC_INCREMENTAL_VERIFY
+    gc_verify_mark_closure();
+    #endif
+    mp_gc_phase = 2;
+    gc_sweep_area = &MP_STATE_MEM(area);
+    gc_sweep_prev = NULL;
+    gc_sweep_block = 0;
+    gc_sweep_free_tail = 0;
+    gc_sweep_last_used = 0;
+    #if MICROPY_PY_GC_COLLECT_RETVAL
+    MP_STATE_MEM(gc_collected) = 0;
+    #endif
+    // Finalisers run while the heap is still intact. They may allocate;
+    // note_alloc keeps those objects because the cursor is still at 0.
+    gc_sweep_run_finalisers();
+}
+
+static void gc_incremental_sweep(uint64_t t0) {
+    while (gc_sweep_area != NULL) {
+        mp_state_mem_area_t *area = gc_sweep_area;
+        size_t max_block = area->gc_alloc_table_byte_len * BLOCKS_PER_ATB;
+        while (max_block > 0 && gc_sweep_block <= area->gc_last_used_block && gc_sweep_block < max_block) {
+            if (gc_budget_exhausted(t0)) {
+                return;
+            }
+            size_t block = gc_sweep_block++;
+            gc_budget_tick();
+            MICROPY_GC_HOOK_LOOP(block);
+            switch (ATB_GET_KIND(area, block)) {
+                case AT_HEAD:
+                    gc_sweep_free_tail = 1;
+                    #if MICROPY_PY_GC_COLLECT_RETVAL
+                    MP_STATE_MEM(gc_collected)++;
+                    #endif
+                    MP_FALLTHROUGH
+                case AT_TAIL:
+                    if (gc_sweep_free_tail) {
+                        ATB_ANY_TO_FREE(area, block);
+                        #if CLEAR_ON_SWEEP
+                        memset((void *)PTR_FROM_BLOCK(area, block), 0, BYTES_PER_BLOCK);
+                        #endif
+                    } else {
+                        gc_sweep_last_used = block;
+                    }
+                    break;
+                case AT_MARK:
+                    ATB_MARK_TO_HEAD(area, block);
+                    gc_sweep_free_tail = 0;
+                    gc_sweep_last_used = block;
+                    break;
+                default:
+                    break;
+            }
+        }
+        if (max_block > 0 && gc_sweep_block <= area->gc_last_used_block && gc_sweep_block < max_block) {
+            return;
+        }
+        area->gc_last_used_block = gc_sweep_last_used;
+        #if MICROPY_GC_SPLIT_HEAP_AUTO
+        if (gc_sweep_last_used == 0 && gc_sweep_prev != NULL) {
+            NEXT_AREA(gc_sweep_prev) = NEXT_AREA(area);
+            mp_state_mem_area_t *next = NEXT_AREA(gc_sweep_prev);
+            MP_PLAT_FREE_HEAP(area);
+            gc_sweep_area = next;
+            gc_sweep_block = 0;
+            gc_sweep_free_tail = 0;
+            gc_sweep_last_used = 0;
+            continue;
+        }
+        #endif
+        gc_sweep_prev = area;
+        gc_sweep_area = NEXT_AREA(area);
+        gc_sweep_block = 0;
+        gc_sweep_free_tail = 0;
+        gc_sweep_last_used = 0;
+    }
+    gc_incremental_finish();
+}
+
+static void gc_incremental_mark(uint64_t t0) {
+    for (;;) {
+        if (gc_budget_exhausted(t0) && !gc_partial_active && gc_mark_sp == 0 && !gc_ovf_active && !MP_STATE_MEM(gc_stack_overflow)) {
+            // Nothing left, so the budget must not block the transition to sweep.
+            break;
+        }
+        if (gc_partial_active) {
+            if (gc_trace_block(gc_partial_area, gc_partial_block, gc_partial_word, t0)) {
+                return;
+            }
+            continue;
+        }
+        if (gc_mark_sp > 0) {
+            if (gc_budget_exhausted(t0)) {
+                return;
+            }
+            gc_mark_sp--;
+            size_t block = MP_STATE_MEM(gc_block_stack)[gc_mark_sp];
+            #if MICROPY_GC_SPLIT_HEAP
+            mp_state_mem_area_t *area = MP_STATE_MEM(gc_area_stack)[gc_mark_sp];
+            #else
+            mp_state_mem_area_t *area = &MP_STATE_MEM(area);
+            #endif
+            if (gc_trace_block(area, block, 0, t0)) {
+                return;
+            }
+            continue;
+        }
+        if (MP_STATE_MEM(gc_stack_overflow) || gc_ovf_active) {
+            if (gc_budget_exhausted(t0)) {
+                return;
+            }
+            gc_overflow_advance(t0);
+            gc_budget_tick();
+            continue;
+        }
+        break;
+    }
+    gc_incremental_start_sweep();
+}
+
+void gc_incremental_set_force(int on) {
+    if (on) {
+        mp_gc_slice_force = 1;
+        if (mp_gc_phase != 0) {
+            mp_gc_slice_stall = 1;
+        }
+    } else if (!mp_gc_slice_busy) {
+        mp_gc_slice_force = 0;
+    }
+}
+
+static void gc_collect_full_now(void) {
+    if (mp_gc_slice_busy) {
+        // The slice already on the stack must run to the end.
+        mp_gc_slice_force = 1;
+        mp_gc_slice_stall = 1;
+        return;
+    }
+    mp_gc_slice_force = 1;
+    gc_collect();
+    mp_gc_slice_force = 0;
+}
+
+void gc_incremental_collect(void (*extra_roots)(void)) {
+    if (mp_gc_slice_busy) {
+        if (mp_gc_slice_force) {
+            mp_gc_slice_stall = 1;
+        }
+        return;
+    }
+    mp_gc_slice_busy = 1;
+    gc_budget_ticks = 0;
+    uint64_t t0 = gc_now_us();
+    bool started = false;
+    if (mp_gc_phase == 0) {
+        gc_incremental_begin();
+        started = true;
+    }
+    gc_slice_count++;
+    if (started) {
+        gc_slice_log("start", "mark", 0);
+    }
+    if (mp_gc_phase == 1) {
+        uint64_t t_mark = gc_now_us();
+        gc_incremental_scan_vm_roots();
+        if (extra_roots != NULL) {
+            extra_roots();
+        }
+        gc_incremental_mark(t0);
+        gc_mark_us_acc += (uint32_t)(gc_now_us() - t_mark);
+    }
+    if (mp_gc_phase == 2) {
+        uint64_t t_sweep = gc_now_us();
+        gc_incremental_sweep(t0);
+        gc_sweep_us_acc += (uint32_t)(gc_now_us() - t_sweep);
+    }
+    uint64_t now = gc_now_us();
+    if (mp_gc_phase == 0) {
+        // Times include this slice. stall=yes only when a caller forced a full finish.
+        gc_slice_log("done", "idle", (uint32_t)(now - t0));
+    } else if (now - gc_slice_log_us >= 150000) {
+        gc_slice_log_us = now;
+        gc_slice_log("step", mp_gc_phase == 1 ? "mark" : "sweep", (uint32_t)(now - t0));
+    }
+    gc_slice_last_us = now;
+    mp_gc_slice_busy = 0;
+}
+
+void gc_incremental_poll(void) {
+    if (mp_gc_phase == 0 || mp_gc_slice_busy) {
+        return;
+    }
+    if (MP_STATE_THREAD(gc_lock_depth) != 0) {
+        return;
+    }
+    // Every 8th hook when a gap is configured, so a tight loop does not
+    // read the timer on every branch. A zero gap (host tests) runs each hook.
+    volatile uint32_t gap_us = MICROPY_GC_SLICE_GAP_US;
+    if (gap_us != 0) {
+        if ((++mp_gc_slice_div & 7) != 0) {
+            return;
+        }
+        if ((gc_now_us() - gc_slice_last_us) < (uint64_t)gap_us) {
+            return;
+        }
+    } else {
+        (void)mp_gc_slice_div;
+    }
+    gc_collect();
+}
+
+#endif // MICROPY_GC_INCREMENTAL
+
 #endif // MICROPY_ENABLE_GC
