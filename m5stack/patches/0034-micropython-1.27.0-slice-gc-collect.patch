+// True when this block has already been visited by the current sweep.
+static bool gc_block_was_swept(mp_state_mem_area_t *area, size_t block) {
+    if (gc_sweep_area == NULL) {
+        return false;
+    }
+    for (mp_state_mem_area_t *p = &MP_STATE_MEM(area); p != NULL; p = NEXT_AREA(p)) {
+        if (p == area) {
+            if (p == gc_sweep_area) {
+                return block < gc_sweep_block;
+            }
+            return true;
+        }
+        if (p == gc_sweep_area) {
+            return false;
+        }
+    }
+    return false;
+}
+
+static void gc_incremental_note_alloc(mp_state_mem_area_t *area, size_t start_block, size_t end_block) {
+    if (mp_gc_phase != 2 || start_block > end_block) {
+        return;
+    }
+    bool start_swept = gc_block_was_swept(area, start_block);
+    bool end_swept = gc_block_was_swept(area, end_block);
+    if (!start_swept) {
+        if (ATB_GET_KIND(area, start_block) == AT_HEAD) {
+            ATB_HEAD_TO_MARK(area, start_block);
+        }
+    } else if (!end_swept) {
+        // The head is already behind the cursor and the tail is not.
+        // Keep the unswept tail blocks.
+        gc_sweep_free_tail = 0;
+    }
