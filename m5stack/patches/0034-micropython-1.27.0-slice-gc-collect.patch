+static uint64_t gc_now_us(void) {
+    #if defined(ESP_PLATFORM)
+    return (uint64_t)esp_timer_get_time();
+    #else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000ULL + (uint64_t)(ts.tv_nsec / 1000ULL);
+    #endif
+}
+
+static bool gc_budget_exhausted(uint64_t t0) {
+    if (mp_gc_slice_force) {
+        return false;
+    }
+    // Copy through volatile so a test build can set either budget to 0
+    // without -Werror=type-limits on a constant compare.
+    volatile uint32_t block_budget = MICROPY_GC_SLICE_BUDGET_BLOCKS;
+    volatile uint32_t time_budget = MICROPY_GC_SLICE_BUDGET_US;
+    if (block_budget != 0 && gc_budget_ticks >= block_budget) {
+        return true;
+    }
+    if (time_budget != 0 && gc_budget_ticks != 0 && (gc_budget_ticks & 15) == 0) {
+        if ((gc_now_us() - t0) >= (uint64_t)time_budget) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void gc_budget_tick(void) {
+    if (!mp_gc_slice_force && gc_budget_ticks != (size_t)-1) {
+        gc_budget_ticks++;
+    }
+}
+
+static void gc_gray_push(mp_state_mem_area_t *area, size_t block) {
+    if (gc_mark_sp < MICROPY_ALLOC_GC_STACK_SIZE) {
+        MP_STATE_MEM(gc_block_stack)[gc_mark_sp] = (MICROPY_GC_STACK_ENTRY_TYPE)block;
+        #if MICROPY_GC_SPLIT_HEAP
+        MP_STATE_MEM(gc_area_stack)[gc_mark_sp] = area;
+        #else
+        (void)area;
+        #endif
+        gc_mark_sp++;
+    } else {
+        MP_STATE_MEM(gc_stack_overflow) = 1;
+    }
+}
+
+static void gc_shade_ptr(void *ptr) {
+    #if MICROPY_GC_SPLIT_HEAP
+    mp_state_mem_area_t *area = gc_get_ptr_area(ptr);
+    if (area == NULL) {
+        return;
+    }
+    #else
+    if (!VERIFY_PTR(ptr)) {
+        return;
+    }
+    mp_state_mem_area_t *area = &MP_STATE_MEM(area);
+    #endif
+    size_t block = BLOCK_FROM_PTR(area, ptr);
+    if (ATB_GET_KIND(area, block) != AT_HEAD) {
+        return;
+    }
+    ATB_HEAD_TO_MARK(area, block);
+    gc_gray_push(area, block);
