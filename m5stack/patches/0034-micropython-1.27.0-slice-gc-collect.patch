+static void gc_incremental_begin(void) {
+    mp_gc_phase = 1;
+    gc_mark_sp = 0;
+    gc_partial_active = 0;
+    gc_ovf_active = 0;
+    gc_sweep_area = NULL;
+    gc_sweep_prev = NULL;
+    gc_sweep_block = 0;
+    gc_sweep_free_tail = 0;
+    gc_sweep_last_used = 0;
+    gc_slice_count = 0;
+    gc_mark_us_acc = 0;
+    gc_sweep_us_acc = 0;
+    mp_gc_slice_stall = mp_gc_slice_force ? 1 : 0;
+    MP_STATE_MEM(gc_stack_overflow) = 0;
+    #if MICROPY_GC_ALLOC_THRESHOLD
+    MP_STATE_MEM(gc_alloc_amount) = 0;
+    #endif
+    gc_slice_log_us = gc_now_us();
+}
+
+static void gc_incremental_finish(void) {
+    #if MICROPY_GC_SPLIT_HEAP
+    MP_STATE_MEM(gc_last_free_area) = &MP_STATE_MEM(area);
+    #endif
+    for (mp_state_mem_area_t *area = &MP_STATE_MEM(area); area != NULL; area = NEXT_AREA(area)) {
+        area->gc_last_free_atb_index = 0;
+    }
+    mp_gc_phase = 0;
+    gc_mark_sp = 0;
+    gc_partial_active = 0;
+    gc_ovf_active = 0;
+    gc_sweep_area = NULL;
+    MP_STATE_MEM(gc_stack_overflow) = 0;
+}
+
+static void gc_incremental_abandon(void) {
+    if (mp_gc_phase == 0) {
+        return;
+    }
+    for (mp_state_mem_area_t *area = &MP_STATE_MEM(area); area != NULL; area = NEXT_AREA(area)) {
+        size_t n = area->gc_alloc_table_byte_len * BLOCKS_PER_ATB;
+        if (n == 0) {
+            continue;
+        }
+        size_t last = area->gc_last_used_block;
+        if (last >= n) {
+            last = n - 1;
+        }
+        for (size_t block = 0; block <= last; block++) {
+            if (ATB_GET_KIND(area, block) == AT_MARK) {
+                ATB_MARK_TO_HEAD(area, block);
+            }
+        }
+    }
+    mp_gc_phase = 0;
+    gc_mark_sp = 0;
+    gc_partial_active = 0;
+    gc_ovf_active = 0;
+    gc_sweep_area = NULL;
+    MP_STATE_MEM(gc_stack_overflow) = 0;
+}
