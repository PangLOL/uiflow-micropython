+    void **ptrs = (void **)(void *)&mp_state_ctx;
+    size_t root_start = offsetof(mp_state_ctx_t, thread.dict_locals);
+    size_t root_end = offsetof(mp_state_ctx_t, vm.qstr_last_chunk);
+    gc_collect_root(ptrs + root_start / sizeof(void *), (root_end - root_start) / sizeof(void *));
+    #if MICROPY_ENABLE_PYSTACK
+    ptrs = (void **)(void *)MP_STATE_THREAD(pystack_start);
+    gc_collect_root(ptrs, (MP_STATE_THREAD(pystack_cur) - MP_STATE_THREAD(pystack_start)) / sizeof(void *));
+    #endif
+}
+
+// Trace one marked block. Returns true if the slice budget ran out midway.
+static bool gc_trace_block(mp_state_mem_area_t *area, size_t block, size_t start_word, uint64_t t0) {
+    if (ATB_GET_KIND(area, block) != AT_MARK) {
+        gc_partial_active = 0;
+        return false;
+    }
+    size_t n_blocks = 0;
+    do {
+        n_blocks += 1;
+    } while (ATB_GET_KIND(area, block + n_blocks) == AT_TAIL);
+
+    void **ptrs = (void **)PTR_FROM_BLOCK(area, block);
+    size_t nptrs = n_blocks * (BYTES_PER_BLOCK / sizeof(void *));
+    for (size_t i = start_word; i < nptrs; i++) {
+        MICROPY_GC_HOOK_LOOP(i);
+        gc_shade_ptr(ptrs[i]);
+        gc_budget_tick();
+        if (gc_budget_exhausted(t0) && (i + 1) < nptrs) {
+            gc_partial_area = area;
+            gc_partial_block = block;
+            gc_partial_word = i + 1;
+            gc_partial_active = 1;
+            return true;
+        }
+    }
+    gc_partial_active = 0;
+    return false;
+}
+
+static void gc_overflow_advance(uint64_t t0) {
+    if (!gc_ovf_active) {
+        if (!MP_STATE_MEM(gc_stack_overflow)) {
+            return;
+        }
+        MP_STATE_MEM(gc_stack_overflow) = 0;
+        gc_ovf_active = 1;
+        gc_ovf_area = &MP_STATE_MEM(area);
+        gc_ovf_block = 0;
+    }
+    mp_state_mem_area_t *area = gc_ovf_area;
+    if (area == NULL) {
+        gc_ovf_active = 0;
+        return;
+    }
+    size_t n = area->gc_alloc_table_byte_len * BLOCKS_PER_ATB;
+    size_t b = gc_ovf_block;
+    size_t skipped = 0;
+    while (b < n && ATB_GET_KIND(area, b) != AT_MARK && skipped < 64) {
+        b++;
+        skipped++;
+    }
+    if (b >= n) {
+        gc_ovf_area = NEXT_AREA(area);
+        gc_ovf_block = 0;
+        if (gc_ovf_area == NULL) {
+            gc_ovf_active = 0;
+        }
+        return;
+    }
+    // Same slicer as the gray stack. Partial state owns a block that did not finish.
+    if (!gc_trace_block(area, b, 0, t0)) {
+        gc_ovf_block = b + 1;
+    }
+}
+
+#if MICROPY_GC_INCREMENTAL_VERIFY
+static void gc_verify_mark_closure(void) {
+    for (mp_state_mem_area_t *area = &MP_STATE_MEM(area); area != NULL; area = NEXT_AREA(area)) {
+        size_t n = area->gc_alloc_table_byte_len * BLOCKS_PER_ATB;
+        if (n == 0) {
+            continue;
+        }
+        size_t last = area->gc_last_used_block;
+        if (last >= n) {
+            last = n - 1;
+        }
+        for (size_t block = 0; block <= last; block++) {
+            if (ATB_GET_KIND(area, block) != AT_MARK) {
+                continue;
+            }
+            size_t n_blocks = 0;
+            do {
+                n_blocks += 1;
+            } while (ATB_GET_KIND(area, block + n_blocks) == AT_TAIL);
+            void **ptrs = (void **)PTR_FROM_BLOCK(area, block);
+            size_t nptrs = n_blocks * (BYTES_PER_BLOCK / sizeof(void *));
+            for (size_t i = 0; i < nptrs; i++) {
+                void *ptr = ptrs[i];
+                #if MICROPY_GC_SPLIT_HEAP
+                mp_state_mem_area_t *child = gc_get_ptr_area(ptr);
+                if (child == NULL) {
+                    continue;
+                }
+                #else
+                if (!VERIFY_PTR(ptr)) {
+                    continue;
+                }
+                mp_state_mem_area_t *child = &MP_STATE_MEM(area);
+                #endif
+                size_t child_block = BLOCK_FROM_PTR(child, ptr);
+                if (ATB_GET_KIND(child, child_block) == AT_HEAD) {
+                    fprintf(stderr, "gc slice verify: marked block %p points at unmarked %p\n",
+                        (void *)PTR_FROM_BLOCK(area, block), ptr);
+                    abort();
+                }
+            }
+        }
+    }
+}
+#endif
